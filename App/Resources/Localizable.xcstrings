    "Square the difference. These are the last two digits": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربّع الفرق. هذان هما آخر رقمين"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fərqi kvadrata yüksəlt. Bunlar son iki rəqəmdir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Узвядзі розніцу ў квадрат. Гэта дзве апошнія лічбы"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повдигни разликата на квадрат. Това са последните две цифри"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পার্থক্যের বর্গ করো। এগুলো শেষ দুটি অঙ্ক"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva la diferència al quadrat. Són les dues últimes xifres"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umocni rozdíl na druhou. To jsou poslední dvě číslice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opløft forskellen i anden. Det er de sidste to cifre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadriere die Differenz. Das sind die letzten zwei Ziffern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ύψωσε τη διαφορά στο τετράγωνο. Αυτά είναι τα δύο τελευταία ψηφία"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva la diferencia al cuadrado. Son las dos últimas cifras"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võta vahe ruutu. Need on kaks viimast numbrit"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اختلاف رو به توان 2 برسون. این‌ها دو رقم آخرن"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korota erotus toiseen. Ne ovat kaksi viimeistä numeroa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-square ang diperensiya. Ito ang huling dalawang digit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets l’écart au carré. Ce sont les deux derniers chiffres"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלה את ההפרש בריבוע. אלה שתי הספרות האחרונות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर का वर्ग करो। ये आख़िरी दो अंक हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvadriraj razliku. To su zadnje dvije znamenke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emeld négyzetre a különbséget. Ez az utolsó két számjegy"
