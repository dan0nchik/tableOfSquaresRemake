    "Faster than your rival. Share the result and challenge a friend": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسرع من منافسك. شارك النتيجة وتحدَّ صديقًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəqibindən sürətlisən. Nəticəni paylaş və dostuna meydan oxu"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты хутчэйшы за суперніка. Падзяліся вынікам і кінь выклік сябру"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-бърз си от съперника. Сподели резултата и предизвикай приятел"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদ্বন্দ্বীর চেয়ে দ্রুত। ফলাফল শেয়ার করো আর বন্ধুকে চ্যালেঞ্জ দাও"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Més ràpid que el teu rival. Comparteix el resultat i repta un amic"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlejší než soupeř. Sdílej výsledek a vyzvi kamaráda"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigere end din modstander. Del resultatet, og udfordr en ven"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller als dein Gegner. Teile das Ergebnis und fordere einen Freund heraus"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιο γρήγορος από τον αντίπαλο. Μοιράσου το αποτέλεσμα και προκάλεσε έναν φίλο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido que tu rival. Comparte el resultado y reta a un amigo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiirem kui vastane. Jaga tulemust ja kutsu sõber võistlema"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سریع‌تر از حریفت. نتیجه رو بفرست و یه دوست رو به چالش بکش"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeampi kuin vastustajasi. Jaa tulos ja haasta kaveri"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mabilis ka sa kalaban. I-share ang resulta at hamunin ang kaibigan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide que ton rival. Partage le résultat et défie un ami"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהיר יותר מהיריב. שתף את התוצאה ואתגר חבר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिद्वंद्वी से तेज़। नतीजा शेयर करो और दोस्त को चुनौती दो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brži od suparnika. Podijeli rezultat i izazovi prijatelja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsabb voltál, mint az ellenfeled. Oszd meg az eredményt, és hívd ki egy barátodat"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դու մրցակցիցդ արագ ես։ Կիսվիր արդյունքով և մարտահրավեր նետիր ընկերոջդ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih cepat dari lawanmu. Bagikan hasilnya dan tantang temanmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più veloce del tuo rivale. Condividi il risultato e sfida un amico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手より速かった！結果をシェアして友だちに挑戦しよう"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეტოქეზე სწრაფი ხარ. გააზიარე შედეგი და გამოიწვიე მეგობარი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарсыласыңнан жылдамсың. Нәтижемен бөліс те, досыңды сайысқа шақыр"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대보다 빨랐어. 결과를 공유하고 친구에게 도전해"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Greitesnis už varžovą. Pasidalyk rezultatu ir mesk iššūkį draugui"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ātrāks par pretinieku. Dalies ar rezultātu un izaicini draugu"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिस्पर्ध्यापेक्षा वेगवान. निकाल शेअर कर आणि मित्राला आव्हान दे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih laju daripada lawan. Kongsi keputusan dan cabar kawan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskere enn motstanderen. Del resultatet og utfordre en venn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneller dan je tegenstander. Deel het resultaat en daag een vriend uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybciej niż rywal. Udostępnij wynik i wyzwij znajomego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais rápido que seu rival. Compartilhe o resultado e desafie um amigo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais rápido do que o teu rival. Partilha o resultado e desafia um amigo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai rapid decât rivalul. Distribuie rezultatul și provoacă un prieten"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты быстрее соперника. Поделись результатом и брось вызов другу"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchlejší ako súper. Zdieľaj výsledok a vyzvi kamaráta"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitrejši od tekmeca. Deli rezultat in izzovi prijatelja"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Бржи си од ривала. Подели резултат и изазови друга"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbare än din motståndare. Dela resultatet och utmana en kompis"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umemzidi mpinzani kwa kasi. Shiriki matokeo na mpe changamoto rafiki"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதிராளியை விட வேகம். முடிவைப் பகிர்ந்து நண்பனுக்கு சவால் விடு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రత్యర్థి కంటే వేగంగా. ఫలితాన్ని షేర్ చేసి స్నేహితుడికి సవాలు విసురు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เร็วกว่าคู่แข่ง แชร์ผลแล้วท้าเพื่อนเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakibinden hızlısın. Sonucu paylaş ve bir arkadaşına meydan oku"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти швидший за суперника. Поділися результатом і кинь виклик другові"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حریف سے تیز۔ نتیجہ شیئر کرو اور دوست کو چیلنج دو"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Raqibingdan tezroqsan. Natijang bilan boʻlish va doʻstingni bellashuvga chorla"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhanh hơn đối thủ. Chia sẻ kết quả và thách đấu bạn bè"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比对手更快！分享成绩，向朋友发起挑战"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比對手更快！分享成績，向朋友下戰帖"
          }
        }
      }
    },
