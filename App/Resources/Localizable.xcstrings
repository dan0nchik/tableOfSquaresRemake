        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κάρτες που δεν ήξερες επέστρεφαν μέχρι να τις μάθεις"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas que no sabías volvieron hasta que te las supiste"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaardid, mida sa ei teadnud, tulid tagasi, kuni need selgeks said"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارت‌هایی که بلد نبودی برگشتن تا یادشون گرفتی"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortit, joita et osannut, palasivat, kunnes osasit ne"
