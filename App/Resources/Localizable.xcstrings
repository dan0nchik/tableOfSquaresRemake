          "stringUnit": {
            "state": "translated",
            "value": "ఎప్పుడూ తప్పు చేయదు. అన్‌లాక్ చేయడానికి గుడ్లగూబను ఓడించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เคยผิด ชนะนกฮูกเพื่อปลดล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla hata yapmaz. Açmak için Baykuş'u yen"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи не помиляється. Обжени Сову, щоб відкрити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کبھی غلطی نہیں کرتا۔ کھولنے کے لیے الو کو ہراؤ"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hech qachon xato qilmaydi. Ochish uchun Boyqushni yeng"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ sai. Thắng Cú mèo để mở khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不出错。战胜猫头鹰后解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從不出錯。打敗貓頭鷹後解鎖"
          }
        }
      }
    },
