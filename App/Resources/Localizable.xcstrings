    "Cards you did not know came back until you did": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات التي لم تعرفها عادت حتى عرفتها"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilmədiyin kartlar öyrənənə qədər geri qayıtdı"
          }
        },
        "be": {
          "stringUnit": {
