    "Tap to flip. Swipe right if you knew it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر للقلب. اسحب يمينًا إذا كنت تعرفه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevirmək üçün toxun. Bilirsənsə, sağa sürüşdür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсні, каб перавярнуць. Правядзі ўправа, калі ведаеш"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни, за да обърнеш. Плъзни надясно, ако знаеш"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্টাতে ট্যাপ করো। জানলে ডানে সোয়াইপ করো"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per girar. Llisca a la dreta si te la sabies"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím otoč. Přejeď doprava, pokud jsi to věděl"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at vende. Swipe til højre, hvis du kunne det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Umdrehen. Wische nach rechts, wenn du es wusstest"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα για να γυρίσει. Σύρε δεξιά αν το ήξερες"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para girar. Desliza a la derecha si lo sabías"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta, et pöörata. Libista paremale, kui teadsid"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای برگردوندن بزن. اگه بلد بودی به راست بکش"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kääntääksesi. Pyyhkäise oikealle, jos osasit"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap para i-flip. I-swipe pakanan kung alam mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche pour retourner. Glisse à droite si tu savais"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי להפוך. החלק ימינה אם ידעת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पलटने के लिए टैप करो। अगर आता था तो दाईं ओर स्वाइप करो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za okretanje. Povuci desno ako si znao"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a megfordításhoz. Húzd jobbra, ha tudtad"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հպիր՝ շրջելու համար։ Սահեցրու աջ, եթե գիտես"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk membalik. Geser ke kanan kalau kamu tahu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per girare. Scorri a destra se la sapevi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでめくる。わかったら右へスワイプ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეეხე გადასაბრუნებლად. გაასრიალე მარჯვნივ, თუ იცი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудару үшін түрт. Білсең, оңға сырғыт"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 뒤집기. 알았으면 오른쪽으로 밀기"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelk, kad apverstum. Perbrauk į dešinę, jei žinojai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries, lai apgrieztu. Velc pa labi, ja zināji"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उलटण्यासाठी टॅप कर. आले असेल तर उजवीकडे सरकव"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk terbalikkan. Leret ke kanan jika kamu tahu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å snu. Sveip til høyre hvis du kunne det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om om te draaien. Veeg naar rechts als je het wist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby odwrócić. Przesuń w prawo, jeśli wiedziałeś"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para virar. Deslize para a direita se você sabia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para virar. Desliza para a direita se sabias"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ca să întorci. Glisează la dreapta dacă l-ai știut"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми, чтобы перевернуть. Смахни вправо, если знаешь"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím otoč. Potiahni doprava, ak si to vedel"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni, da obrneš. Povleci desno, če si znal"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирни да окренеш. Превуци удесно ако си знао"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att vända. Svep höger om du kunde det"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa ili kugeuza. Telezesha kulia kama uliijua"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திருப்ப தட்டு. தெரிந்திருந்தால் வலப்புறம் தள்ளு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తిప్పడానికి తాకు. తెలిస్తే కుడివైపుకి స్వైప్ చెయ్యి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อพลิก ปัดขวาถ้ารู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevirmek için dokun. Bildiysen sağa kaydır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись, щоб перевернути. Проведи вправо, якщо знаєш"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پلٹنے کے لیے ٹیپ کرو۔ اگر آتا تھا تو دائیں سوائپ کرو"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Agʻdarish uchun bos. Bilsang, oʻngga sur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để lật. Vuốt sang phải nếu bạn biết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击翻面。会的话向右滑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下翻面。會的話往右滑"
          }
        }
      }
    },
    "Thank you to everyone who bought the school project. This remake is for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لكل من اشترى المشروع المدرسي. هذه النسخة الجديدة لكم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
