    "Use it in races and duels. It is faster than memorizing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمها في السباقات والمبارزات. إنها أسرع من الحفظ"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondan yarışlarda və duellərdə istifadə et. Bu, əzbərləməkdən daha sürətlidir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўвай яго ў гонках і дуэлях. Гэта хутчэй, чым зубрыць"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвай го в състезания и дуели. По-бързо е от наизустяване"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৌড় আর দ্বন্দ্বে এটা কাজে লাগাও। মুখস্থ করার চেয়ে দ্রুত"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes-lo servir en curses i duels. És més ràpid que memoritzar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používej ho v závodech a duelech. Je to rychlejší než biflování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug det i løb og dueller. Det er hurtigere end at lære udenad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze ihn in Rennen und Duellen. Das geht schneller als Auswendiglernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησέ το σε αγώνες και μονομαχίες. Είναι πιο γρήγορο από την αποστήθιση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo en carreras y duelos. Es más rápido que memorizar"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta seda võidujooksudes ja duellides. See on kiirem kui pähe õppimine"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تو مسابقه‌ها و دوئل‌ها ازش استفاده کن. از حفظ کردن سریع‌تره"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä sitä kisoissa ja kaksintaisteluissa. Se on nopeampaa kuin ulkoa opettelu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ito sa karera at duelo. Mas mabilis kaysa magmemorya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise-la en course et en duel. C’est plus rapide que d’apprendre par cœur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בזה במרוצים ובדו־קרבות. זה מהיר יותר משינון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे रेस और मुकाबलों में इस्तेमाल करो। यह रटने से तेज़ है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi ga u utrkama i dvobojima. Brže je od učenja napamet"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd versenyben és párbajban. Gyorsabb, mint bemagolni"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործիր այն մրցավազքերում և մենամարտերում։ Դա ավելի արագ է, քան անգիր անելը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai di balapan dan duel. Lebih cepat daripada menghafal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usalo in gare e duelli. È più veloce che imparare a memoria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レースやデュエルで使おう。暗記するより速い"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენე რბოლებსა და დუელებში. ეს დაზეპირებაზე სწრაფია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны жарыстар мен дуэльдерде қолдан. Бұл жаттағаннан жылдамырақ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이스와 대결에서 써 봐. 외우는 것보다 빨라"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudok jį lenktynėse ir dvikovose. Tai greičiau nei kalti mintinai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmanto to sacīkstēs un dueļos. Tas ir ātrāk nekā iegaumēt"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शर्यती आणि द्वंद्वात वापर. पाठ करण्यापेक्षा हे वेगवान आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakannya dalam perlumbaan dan duel. Lebih laju daripada menghafal"
          }
        },
