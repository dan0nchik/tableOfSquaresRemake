    "Orange is what was added to %lld²: %lld + %lld = %lld cells": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البرتقالي هو ما أُضيف إلى %lld²: %lld + %lld = %lld خانة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Narıncı xanalar %lld² üzərinə əlavə olunanlardır: %lld + %lld = %lld xana"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аранжавым — тое, што дадалося да %lld²: %lld + %lld = %lld клетак"
