    "Knowing squares both ways is what exams check": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الامتحانات تختبر معرفتك بالمربعات في الاتجاهين"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İmtahanlar kvadratları hər iki istiqamətdə bilməyi yoxlayır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На экзаменах правяраюць веданне квадратаў у абодва бакі"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На изпитите проверяват квадратите и в двете посоки"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষায় দেখা হয় তুমি বর্গ দুদিক থেকেই জানো কি না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber els quadrats en els dos sentits és el que demanen els exàmens"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znát čtverce oběma směry je přesně to, co testují zkoušky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er at kunne kvadrater begge veje, eksamener tester"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadrate in beide Richtungen zu kennen, wird in Prüfungen abgefragt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εξετάσεις ελέγχουν αν ξέρεις τα τετράγωνα και αντίστροφα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber los cuadrados en ambos sentidos es lo que piden los exámenes"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksamitel kontrollitakse just ruutude teadmist mõlemas suunas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امتحان‌ها دقیقاً همینو می‌سنجن: شناخت مربع‌ها از هر دو طرف"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeissa testataan neliöiden osaamista molempiin suuntiin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pag-alam ng kuwadrado pabalik-balik ang sinusubok sa exam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connaître les carrés dans les deux sens, c’est ce que vérifient les examens"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במבחנים בודקים שאתה יודע ריבועים בשני הכיוונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परीक्षा में वर्ग दोनों तरफ़ से जानना ही परखा जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispiti provjeravaju znaš li kvadrate u oba smjera"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vizsgák azt nézik, hogy mindkét irányban ismered-e a négyzeteket"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քննությունները ստուգում են քառակուսիների իմացությունը երկու ուղղությամբ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian menguji apakah kamu paham kuadrat bolak-balik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoscere i quadrati in entrambi i sensi è ciò che chiedono gli esami"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2乗を両方向で知っていることが試験で問われる"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოცდებზე ამოწმებენ კვადრატების ცოდნას ორივე მიმართულებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Емтихандар квадраттарды екі бағытта да білуді тексереді"
          }
        },
        "ko": {
          "stringUnit": {
