    "Reset all progress?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة ضبط كل التقدم؟"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün irəliləyiş sıfırlansın?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скінуць увесь прагрэс?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да нулирам ли целия напредък?"
          }
        },
        "bn": {
