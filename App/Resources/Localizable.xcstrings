    "New squares are yours. Come back tomorrow so they do not fade": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مربعات جديدة أصبحت لك. عد غدًا كي لا تتلاشى"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kvadratlar sənindir. Solmasınlar deyə sabah qayıt"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новыя квадраты твае. Вяртайся заўтра, каб яны не пацьмянелі"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Новите квадрати са твои. Върни се утре, за да не избледнеят"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন বর্গগুলো এখন তোমার। কাল আবার এসো, যাতে ফিকে না হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els quadrats nous són teus. Torna demà perquè no s'esvaeixin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové čtverce jsou tvoje. Vrať se zítra, ať nevyblednou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye kvadrater er dine. Kom igen i morgen, så de ikke falmer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Quadrate gehören dir. Komm morgen wieder, damit sie nicht verblassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα νέα τετράγωνα είναι δικά σου. Έλα αύριο για να μην ξεθωριάσουν"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuadrados nuevos son tuyos. Vuelve mañana para que no se desvanezcan"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uued ruudud on sinu. Tule homme tagasi, et need ei tuhmuks"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مربع‌های جدید مال تو شدن. فردا برگرد تا کم‌رنگ نشن"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet neliöt ovat sinun. Palaa huomenna, etteivät ne haalistu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iyo na ang mga bagong kuwadrado. Bumalik bukas para hindi sila kumupas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux carrés sont à toi. Reviens demain pour qu’ils ne pâlissent pas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ריבועים חדשים הם שלך. חזור מחר כדי שלא ידהו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए वर्ग तुम्हारे हुए। कल फिर आना ताकि वे फीके न पड़ें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novi kvadrati su tvoji. Vrati se sutra da ne izblijede"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új négyzetek a tieid. Gyere vissza holnap, hogy ne halványuljanak el"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նոր քառակուսիները քոնն են։ Վերադարձիր վաղը, որ չխամրեն"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuadrat baru jadi milikmu. Kembali besok agar tidak memudar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi quadrati sono tuoi. Torna domani perché non sbiadiscano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいマスは君のもの。色あせないようにまた明日来てね"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი კვადრატები შენია. დაბრუნდი ხვალ, რომ ფერი არ დაკარგონ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа квадраттар сенікі. Олар өшіп қалмас үшін ертең қайта кел"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 칸은 이제 네 거야. 바래지 않게 내일 다시 와"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauji kvadratai tavo. Grįžk rytoj, kad jie neišblėstų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaunie kvadrāti ir tavi. Atgriezies rīt, lai tie neizbalētu"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवे वर्ग तुझे झाले. ते फिके होऊ नयेत म्हणून उद्या परत ये"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuasa dua baharu milik kamu. Datang lagi esok supaya ia tidak pudar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye kvadrater er dine. Kom tilbake i morgen så de ikke falmer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe kwadraten zijn van jou. Kom morgen terug, zodat ze niet vervagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe kwadraty są twoje. Wróć jutro, żeby nie zbladły"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadrados novos são seus. Volte amanhã para eles não desbotarem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadrados novos são teus. Volta amanhã para não desvanecerem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pătratele noi sunt ale tale. Revino mâine ca să nu se estompeze"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые квадраты твои. Возвращайся завтра, чтобы они не потускнели"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nové štvorce sú tvoje. Vráť sa zajtra, nech nevyblednú"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Novi kvadrati so tvoji. Vrni se jutri, da ne zbledijo"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нови квадрати су твоји. Врати се сутра да не избледе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De nya kvadraterna är dina. Kom tillbaka i morgon så att de inte bleknar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Miraba mipya ni yako. Rudi kesho ili isififie"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய வர்க்கங்கள் உனக்குச் சொந்தம். அவை மங்காமல் இருக்க நாளை திரும்ப வா"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త వర్గాలు నీవే. అవి మసకబారకుండా రేపు మళ్ళీ రా"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องใหม่เป็นของเธอแล้ว กลับมาพรุ่งนี้นะจะได้ไม่จาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kareler senin. Solmasınlar diye yarın tekrar gel"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові квадрати твої. Повертайся завтра, щоб вони не потьмяніли"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے مربعے تمہارے ہیں۔ کل واپس آنا تاکہ وہ مدھم نہ ہوں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi kvadratlar seniki. Ular soʻnmasligi uchun ertaga qaytib kel"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ô mới là của bạn. Mai quay lại để chúng không phai nhé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新格子归你了。明天再来，别让它们褪色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的格子是你的了。明天再來，別讓它們褪色"
          }
        }
      }
    },
