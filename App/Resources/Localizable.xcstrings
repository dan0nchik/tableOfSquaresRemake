            "value": "Gata. Merge pentru orice număr terminat în 5"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Работает для любого числа на 5"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo. Funguje pre každé číslo končiace päťkou"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Končano. Deluje za vsako število, ki se konča s 5"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Ради за сваки број који се завршава на 5"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart. Funkar för alla tal som slutar på 5"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayari. Inafanya kazi kwa kila namba inayoishia na 5"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்தது. 5-இல் முடியும் எல்லா எண்களுக்கும் இது வேலை செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అయిపోయింది. 5తో ముగిసే ప్రతి సంఖ్యకూ పనిచేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว ใช้ได้กับทุกจำนวนที่ลงท้ายด้วย 5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti. 5 ile biten her sayıda işe yarar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Працює для будь-якого числа на 5"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو گیا۔ یہ 5 پر ختم ہونے والے ہر عدد کے لیے کام کرتا ہے"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayyor. 5 bilan tugaydigan har qanday son uchun ishlaydi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong. Áp dụng cho mọi số tận cùng là 5"
          }
        },
        "zh-Hans": {
