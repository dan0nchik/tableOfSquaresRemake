        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কার্ডগুলো জানতে না, সেগুলো শেখা পর্যন্ত বারবার ফিরে এসেছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les targetes que no sabies tornaven fins que te les sabies"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartičky, které jsi neznal, se vracely, dokud ses je nenaučil"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort, du ikke kunne, kom igen, indtil du kunne dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten, die du nicht wusstest, kamen zurück, bis du sie konntest"
