        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերությունը բարձրացրու քառակուսի։ Սրանք վերջին երկու թվանշաններն են"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuadratkan selisihnya. Ini dua angka terakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva al quadrato la differenza. Sono le ultime due cifre"
          }
        },
        "ja": {
