    "Never makes mistakes. Beat Owl to unlock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يخطئ أبدًا. تغلّب على البومة لفتحه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç vaxt səhv etmir. Açmaq üçün Bayquşa qalib gəl"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколі не памыляецца. Абгані Саву, каб адкрыць"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не греши. Победи Бухала, за да отключиш"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখনো ভুল করে না। আনলক করতে পেঁচাকে হারাও"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'equivoca mai. Venç el Mussol per desbloquejar-lo"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy se nesplete. Poraz Sovu a odemkni ho"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Laver aldrig fejl. Slå Ugle for at låse op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht nie Fehler. Schlag die Eule, um ihn freizuschalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν κάνει ποτέ λάθος. Νίκησε την Κουκουβάγια για να ξεκλειδώσει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se equivoca. Vence al Búho para desbloquearlo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei eksi kunagi. Võida Öökulli, et avada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ‌وقت اشتباه نمی‌کنه. جغد رو ببر تا باز بشه"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei koskaan erehdy. Voita Pöllö avataksesi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailanman nagkakamali. Talunin ang Kuwago para ma-unlock"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne se trompe jamais. Bats la Chouette pour le débloquer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף פעם לא טועה. נצח את הינשוף כדי לפתוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी गलती नहीं करता। खोलने के लिए उल्लू को हराओ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikad ne griješi. Pobijedi Sovu da ga otključaš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosem hibázik. Győzd le a Baglyot a feloldáshoz"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբեք չի սխալվում։ Հաղթիր Բվին՝ բացելու համար"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pernah salah. Kalahkan Burung Hantu untuk membuka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sbaglia mai. Batti il Gufo per sbloccarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶対にミスしない。フクロウに勝つと解放"
